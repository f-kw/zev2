+test('combined proof validates saved compact decode observations without raw artifacts and rejects independent tampering', () => {
+  const fixture = () => combinedEvidenceFixture('compact', {distinctNormalPng: true});
+  const original = fixture(), finite = original.finite.evidence;
+  assert.equal(finite.decodedLayers.layers.length, 2);
+  const rawPaths = new Set(finite.nativeLayers.layers.map(layer => layer.decodedPath));
+  assert(finite.outputArtifacts.every(ref => !rawPaths.has(ref.path)));
+  // These synthetic paths never contain files; saved validation needs the
+  // recorded chain, while actual generation verifies all raw bytes before release.
+  const saved = JSON.parse(JSON.stringify(original));
+  assert.equal(combinePresentationIntegrityStateQcV001(saved).status, 'passed');
+  const observations = f => f.finite.evidence.decodedLayers.layers;
+  const decoders = f => f.finite.evidence.processes.filter(row => row.purpose === 'native-layer-decode');
+  const changes = [
+    ['missing compact observations', f => {delete f.finite.evidence.decodedLayers;}],
+    ['wrong compact schema', f => {f.finite.evidence.decodedLayers.schemaVersion = 'other';}],
+    ['extra compact container field', f => {f.finite.evidence.decodedLayers.extra = true;}],
+    ['missing observation', f => {observations(f).pop();}],
+    ['duplicate observation', f => {observations(f).push(clone(observations(f)[0]));}],
+    ['reordered observations', f => {observations(f).reverse();}],
+    ['extra observation field', f => {observations(f)[0].extra = true;}],
+    ['another layer key', f => {observations(f)[0].layerKey = observations(f)[1].layerKey;}],
+    ['changed source PNG hash', f => {observations(f)[0].sourcePngSha256 = hash('changed-source');}],
+    ['changed prepared PNG hash', f => {observations(f)[0].preparedPngSha256 = hash('changed-prepared');}],
+    ['changed decode command hash', f => {observations(f)[0].decodeArgumentsCanonicalSha256 = hash('changed-command');}],
+    ['changed decoded byte count', f => {observations(f)[0].decodedBytes++;}],
+    ['changed decoded hash', f => {observations(f)[0].decodedSha256 = hash('changed-raw');}],
+    ['swapped decoded hashes', f => {
+      const rows = observations(f);
+      [rows[0].decodedSha256, rows[1].decodedSha256] = [rows[1].decodedSha256, rows[0].decodedSha256];
+    }],
+    ['missing decode output list', f => {delete decoders(f)[0].outputFiles;}],
+    ['extra decode output field', f => {decoders(f)[0].outputFiles[0].extra = true;}],
+    ['changed process output hash', f => {decoders(f)[0].outputFiles[0].fileSha256 = hash('changed-process-raw');}],
+    ['malformed process and compact raw hash', f => {
+      decoders(f)[0].outputFiles[0].fileSha256 = 'invalid';
+      observations(f)[0].decodedSha256 = 'invalid';
+    }],
+    ['changed process output byte count', f => {decoders(f)[0].outputFiles[0].bytes++;}],
+    ['changed process and compact byte count', f => {
+      decoders(f)[0].outputFiles[0].bytes++;
+      observations(f)[0].decodedBytes++;
+    }],
+    ['swapped process output lists', f => {
+      const processes = decoders(f);
+      [processes[0].outputFiles, processes[1].outputFiles] = [processes[1].outputFiles, processes[0].outputFiles];
+    }],
+    ['raw output included among retained artifacts', f => {
+      const output = decoders(f)[0].outputFiles[0];
+      f.finite.evidence.outputArtifacts.push({path: output.path, fileSha256: output.fileSha256});
+    }],
+  ];
+  for (const [label, change] of changes) {
+    const f = fixture(); change(f);
+    const result = combinePresentationIntegrityStateQcV001(f);
+    assert.equal(result.status, 'failed', label);
+    assert.ok(result.violations.some(row => row.code === 'INTEGRITY_STATE_QC_INVALID'), label);
+  }
+});
