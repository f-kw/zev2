    "readerCode": "import assert from 'node:assert/strict';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport {createHash} from 'node:crypto';\nconst root='/Users/kawafmm/workspace/zev2';\nconst report=path.join(root,'docs/reports/request-intent-connection-20261001');\nconst readJson=async(p:string)=>JSON.parse(await fs.promises.readFile(p,'utf8'));\nconst hash=(b:Uint8Array|string)=>createHash('sha256').update(b).digest('hex');\nconst fileSha=async(p:string)=>{const h=createHash('sha256');for await(const b of fs.createReadStream(p))h.update(b);return h.digest('hex');};\nconst evidence=await readJson(path.join(report,'queue-local-mp4-no-inspection-evidence-attempt-007.json'));\nassert.equal(evidence.status,'passed');assert.equal(evidence.completed.length,1);\nconst entry=evidence.completed[0],runtime=path.join(root,entry.backendRuntime),artifactRoot=path.join(root,entry.readerArtifactRoot);\nprocess.env.ZEV2_RUNTIME_DIR=runtime;process.env.ZEV2_DISABLE_AUTO_RUNNER='1';\nconst statePath=path.join(runtime,'state.json'),stateBytes=await fs.promises.readFile(statePath);\nconst {loadState,readStateSnapshot}=await import(path.join(root,'backend/src/store/json-store.ts'));\nconst loaded=await loadState(),state=await readStateSnapshot();assert.deepEqual(loaded,state);\nassert.deepEqual(state.agentRequests.map((r:any)=>r.type),['prepare_video','run_stt','prepare_digest_plan','validate_digest_plan']);\nassert(state.agentRequests.every((r:any)=>r.status==='succeeded'));assert.equal(state.controlReviewItems.length,0);\nconst ownedOutputs:any[]=[];\nfor(const r of state.agentRequests){\n  const o=state.outputs.find((v:any)=>v.id===r.result.outputId),f=state.fileRefs.find((v:any)=>v.id===r.result.fileRefId);\n  assert(o && f);assert.equal(o.fileRefId,f.id);assert.equal(f.ownerId,o.id);assert.equal(r.result.outputType,o.type);assert.deepEqual(r.fileRefIds,[f.id]);\n  const p=path.join(artifactRoot,entry.draftId,f.artifactFileName),s=await fs.promises.lstat(p);assert(s.isFile()&&!s.isSymbolicLink());assert.equal(s.size,f.byteSize);\n  assert.equal(await fileSha(p),f.sha256);\n  ownedOutputs.push({requestId:r.id,type:r.type,status:r.status,outputId:o.id,outputType:o.type,fileRefId:f.id,ownerId:f.ownerId,kind:f.kind,path:path.relative(root,p),mimeType:f.mimeType,byteSize:f.byteSize,sha256:f.sha256});\n}\nconst sourceRef=ownedOutputs[0];assert.equal(sourceRef.mimeType,'video/mp4');assert.equal(sourceRef.kind,'source_video');\nconst sourcePath=evidence.preflight.source.path,sourceStat=await fs.promises.lstat(sourcePath);\nassert.equal(sourceStat.size,sourceRef.byteSize);const sourceSha=await fileSha(sourcePath);assert.equal(sourceSha,sourceRef.sha256);\nconst logicalFile=(logical:string)=>{const parts=logical.split('/');assert.equal(parts[0],'artifacts');assert.equal(parts[1],entry.draftId);assert.equal(parts.length,4);return path.join(artifactRoot,parts[1],parts[2]+'--'+parts[3]);};\nconst plan=await readJson(path.join(root,entry.planPath)),preparation=await readJson(logicalFile(plan.preparationBinding.path));\nassert.equal(preparation.identity.sourceOrigin.mode,'video-bytes');assert.deepEqual(preparation.identity.sourceRegistration,preparation.identity.sourceVideo);\nassert.equal(preparation.identity.sourceVideo.fileSha256,sourceSha);assert.equal(preparation.identity.sourceOrigin.byteSize,sourceRef.byteSize);assert.equal(preparation.identity.sourceInspection,null);\nconst request=state.agentRequests.find((r:any)=>r.id===entry.validateRequestId),executionBytes=await fs.promises.readFile(path.join(root,entry.executionPath)),execution=JSON.parse(executionBytes.toString());\nconst validateRef=ownedOutputs.find(v=>v.requestId===request.id);assert.equal(hash(executionBytes),validateRef.sha256);\nfor(const field of ['sourceInspectionBinding','consumptionBinding','editPlanBinding','manufacturingInputBinding','clockResolutionBinding'])assert.equal(execution[field],null);\nassert.equal(typeof execution.sourceInspectionMissingReason,'string');assert(execution.sourceInspectionMissingReason.trim());\nassert.deepEqual(execution.admission,{planIntegrity:'passed',presentation:'not-connected',executionPermission:'not-approved',humanQuality:'pending'});\nconst directory=path.join(artifactRoot,entry.draftId),names=await fs.promises.readdir(directory);\nconst absentArtifacts=['source-inspection.json','source-media-inspection.json','consumption-binding.json','clock-resolution.json','machine-adoption.json','edit-plan.json','manufacturing-values.json'];\nfor(const n of absentArtifacts)assert(!names.some(v=>v.endsWith('--'+n)),n);\nconst mediaCopies=names.filter(v=>v.endsWith('.mp4'));assert.deepEqual(mediaCopies,[path.basename(sourceRef.path)]);\nconst {readConsumedDigestPlanV001}=await import(path.join(root,'runner/src/digest-plan-consumption-v001.ts'));\nconst before=Date.now(),result=await readConsumedDigestPlanV001({preparation:{workspaceRoot:root,artifactRoot}},{request,state});\nassert.equal(result.status,'inspection-missing');assert.deepEqual(result.artifact,execution);assert.deepEqual(await fs.promises.readFile(statePath),stateBytes);\nconst readerElapsedMs=Date.now()-before;\nconst cross:any[]=[];\nfor(const name of ['queue-upload-transfer-evidence-attempt-006.json','queue-local-mp4-no-inspection-evidence-attempt-007.json']){\n  const proofBytes=await fs.promises.readFile(path.join(report,name)),proof=JSON.parse(proofBytes.toString());assert.equal(proof.status,'passed');assert.equal(proof.completed.length,1);\n  const e=proof.completed[0],base=path.join(root,e.backendRuntime,'artifacts',e.draftId),checks:any[]=[];\n  assert.deepEqual(proof.captures.map((v:any)=>v.stage),['discovery','selection','retention']);\n  for(const [stage,qname,aname]of [['discovery','candidate-request.json','candidate-response.json'],['selection','selection-request.json','selection-response.json'],['retention','retention-request.json','retention-response.json']]){\n    const qpath=path.join(base,e.prepareRequestId+'--'+qname),apath=path.join(base,e.prepareRequestId+'--'+aname),bytes=await fs.promises.readFile(qpath),q=JSON.parse(bytes.toString()),a=await readJson(apath);\n    const capture=proof.captures.find((v:any)=>v.stage===stage),purpose=stage==='retention'?q.input.taskDescription:q.input.productionRequest;\n    assert.equal(purpose,capture.purpose);assert.equal(hash(bytes),capture.requestFileSha256);assert.equal(a.requestFileSha256,hash(bytes));\n    checks.push({stage,purpose,requestPath:path.relative(root,qpath),requestFileSha256:hash(bytes),answerPath:path.relative(root,apath),answerRequestFileSha256:a.requestFileSha256});\n  }\n  assert(checks.every(v=>v.purpose===checks[0].purpose));cross.push({attempt:proof.attempt,evidencePath:path.relative(root,path.join(report,name)),evidenceFileSha256:hash(proofBytes),purpose:checks[0].purpose,checks});\n}\nassert.notEqual(cross[0].purpose,cross[1].purpose);for(let i=0;i<3;i++)assert.notEqual(cross[0].checks[i].requestFileSha256,cross[1].checks[i].requestFileSha256);\nconst proof={schemaVersion:'request-intent-local-mp4-readback-proof-v001',status:'passed',separateProcess:true,actualStoreRead:true,backendStoppedBeforeRead:true,ownedOutputs,\n  originalSource:{path:sourcePath,byteSize:sourceStat.size,sha256:sourceSha},sourceRegistrationMode:preparation.identity.sourceOrigin.mode,sourceBindingsIdentical:true,sourceInspection:null,\n  executionPath:entry.executionPath,executionFileSha256:hash(executionBytes),executionByteSize:executionBytes.length,executionNullFields:['sourceInspectionBinding','consumptionBinding','editPlanBinding','manufacturingInputBinding','clockResolutionBinding'],missingReason:execution.sourceInspectionMissingReason,admission:execution.admission,\n  absentArtifacts,largeCopies:mediaCopies.length,actualReader:'readConsumedDigestPlanV001',readerStatus:result.status,artifactsDeepEqual:true,stateByteUnchanged:true,stateByteSize:stateBytes.length,stateSha256:hash(stateBytes),rejudgment:false,registrationOrCompleteRepeated:fals