        "presetLabel": "Color",
        "hasOverride": false,
        "status": "selected",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000018",
        "text": "まぁでも怖かったね",
        "startFrame": 3033,
        "endFrameExclusive": 3167,
        "preset": "normal",
        "presetLabel": "Normal（通常表示）",
        "hasOverride": false,
        "status": "normal",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000019",
        "text": "やっぱここの会社さ、アングル攻めんのやめてほしい",
        "startFrame": 3167,
        "endFrameExclusive": 3322,
        "preset": "color",
        "presetLabel": "Color",
        "hasOverride": false,
        "status": "selected",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000020",
        "text": "マジで怖い",
        "startFrame": 3322,
        "endFrameExclusive": 3382,
        "preset": "scale",
        "presetLabel": "Scale",
        "hasOverride": false,
        "status": "selected",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000021",
        "text": "なんかさぁアングルで怖がらせんのマジ上手いと思うここの会社",
        "startFrame": 3382,
        "endFrameExclusive": 3599,
        "preset": "color",
        "presetLabel": "Color",
        "hasOverride": false,
        "status": "selected",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000022",
        "text": "カメラワークと今回時間差怖かった",
        "startFrame": 3599,
        "endFrameExclusive": 3705,
        "preset": "panel",
        "presetLabel": "Panel",
        "hasOverride": false,
        "status": "selected",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000023",
        "text": "いや分かってるよ",
        "startFrame": 3705,
        "endFrameExclusive": 3791,
        "preset": "normal",
        "presetLabel": "Normal（通常表示）",
        "hasOverride": false,
        "status": "normal",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000024",
        "text": "なんかやっぱさ",
        "startFrame": 3791,
        "endFrameExclusive": 3810,
        "preset": "normal",
        "presetLabel": "Normal（通常表示）",
        "hasOverride": false,
        "status": "normal",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000025",
        "text": "ホラーゲーやってるとさなんか分かってくるじゃん",
        "startFrame": 3810,
        "endFrameExclusive": 3917,
        "preset": "normal",
        "presetLabel": "Normal（通常表示）",
        "hasOverride": false,
        "status": "normal",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000026",
        "text": "あーここ来そうだなみたいなの",
        "startFrame": 3917,
        "endFrameExclusive": 3986,
        "preset": "color",
        "presetLabel": "Color",
        "hasOverride": false,
        "status": "selected",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000027",
        "text": "ここの会社すごいのがさ",
        "startFrame": 3986,
        "endFrameExclusive": 4068,
        "preset": "normal",
        "presetLabel": "Normal（通常表示）",
        "hasOverride": false,
        "status": "normal",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000028",
        "text": "いやもうなんか来るよなっていうところじゃないところで",
        "startFrame": 4068,
        "endFrameExclusive": 4225,
        "preset": "color",
        "presetLabel": "Color",
        "hasOverride": false,
        "status": "selected",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000029",
        "text": "油断させてビビらせてくるのがマジでここの会社多いなって思う",
        "startFrame": 4267,
        "endFrameExclusive": 4418,
        "preset": "color",
        "presetLabel": "Color",
        "hasOverride": false,
        "status": "selected",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000030",
        "text": "ただ覗くだけであんな毎回さ怖がらさせられてとんでもねえ",
        "startFrame": 4430,
        "endFrameExclusive": 4600,
        "preset": "color",
        "presetLabel": "Color",
        "hasOverride": false,
        "status": "selected",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000031",
        "text": "今年一でしたわ今年一",
        "startFrame": 4600,
        "endFrameExclusive": 4717,
        "preset": "panel",
        "presetLabel": "Panel",
        "hasOverride": false,
        "status": "selected",
        "statusLabel": "自動案"
      },
      {
        "id": "digest-human-caption-repair-20260907-v001-instruction-instruction-000032",
