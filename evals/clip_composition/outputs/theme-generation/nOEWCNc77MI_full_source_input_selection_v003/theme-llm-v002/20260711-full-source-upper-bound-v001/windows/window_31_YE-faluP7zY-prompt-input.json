          {
            "speechId": 790,
            "sourceVideoId": "YE-faluP7zY",
            "sourceStartMs": 5288399,
            "sourceEndMs": 5289900,
            "text": "あ、あ、作ったやつ?"
          },
          {
            "speechId": 791,
            "sourceVideoId": "YE-faluP7zY",
            "sourceStartMs": 5289900,
            "sourceEndMs": 5299307,
            "text": "うん、これは気づきでしたはい、すごーいおめでとうあ、へぇーえ、天井高くする?"
          },
          {
            "speechId": 792,
