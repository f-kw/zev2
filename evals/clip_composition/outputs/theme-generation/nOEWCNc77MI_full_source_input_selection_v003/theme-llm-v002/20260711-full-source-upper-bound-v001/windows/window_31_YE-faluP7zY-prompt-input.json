          {
            "speechId": 787,
            "sourceVideoId": "YE-faluP7zY",
            "sourceStartMs": 5284357,
            "sourceEndMs": 5284977,
            "text": "斧?"
          },
          {
            "speechId": 788,
            "sourceVideoId": "YE-faluP7zY",
            "sourceStartMs": 5284977,
            "sourceEndMs": 5287619,
            "text": "あ、斧で壊せるじゃん!"
          },
          {
            "speechId": 789,
            "sourceVideoId": "YE-faluP7zY",
            "sourceStartMs": 5287619,
            "sourceEndMs": 5288399,
            "text": "何を?"
