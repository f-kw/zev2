          },
          {
            "speechId": 122,
            "sourceVideoId": "YE-faluP7zY",
            "sourceStartMs": 1034412,
            "sourceEndMs": 1039036,
            "text": "待てねーちょっと待てーどっかにないか?"
          },
          {
            "speechId": 123,
            "sourceVideoId": "YE-faluP7zY",
            "sourceStartMs": 1039036,
            "sourceEndMs": 1046161,
