            "text": "{\n  \"themes\": [\n    {\n      \"id\": \"theme_1\",\n      \"title\": \"歌うま企画に男気立候補したリオナ\",\n      \"summary\": \"JPメンバーが決まらずに焦るペコラのもとへ、リオナが突然Discordで「男気立候補」をして救ってくれた熱い裏話。\",\n      \"representativeSpeechIds\": [3107],\n      \"relatedSpeechIds\": [\n        3037, 3038, 3039, 3040, 3041, 3042, 3043, 3044, 3045, 3046, 3047, 3048, 3049, 3050, \n        3107, 3108, 3109, 3110, 3111, 3112, 3113, 3114, 3115, 3116, 3117, 3118, 3119, 3120, \n        3121, 3122, 3123, 3124, 3125, 3126, 3127, 3128, 3129, 3130, 3131, 3132, 3133, 3134, \n        3135, 3136, 3137, 3138, 3139, 3140, 3141, 3142, 3143, 3144, 3145, 3146, 3147, 3148, \n        3149, 3150, 3151, 3152, 3153, 3154, 3155, 3156, 3157, 3158, 3159, 3160, 3161, 3162, \n        3163, 3164, 3165, 3166, 3167, 3168, 3169, 3170, 3171, 3172, 3173, 3174, 3175\n      ],\n      \"reason\": \"Discordの具体的な文面を読み上げており、メンバー間の深い絆や男気が伝わるドラマチックな展開のため、切り抜き動画として非常に引きが強いです。\",\n      \"compositionNote\": \"突然の通知SEとともに「とんでもない心意気のやつが来た」と興奮するペコラから始まり、リオナからのダイレクトなメッセージ内容、そしてペコラが救われ歓喜する様子をテンポよくまとめます。\"\n    },\n    {\n      \"id\": \"theme_2\",\n      \"title\": \"3D生配信中の極秘サイン「指ハート」\",\n      \"summary\": \"配信中にどうしてもトイレに行きたくなったメンバーが、カメラに向けてこっそり行う裏ルール「指ハート」の面白い仕組みを暴露する話。\",\n      \"representativeSpeechIds\": [8200],\n      \"relatedSpeechIds\": [\n        8083, 8084, 8085, 8086, 8087, 8088, 8089, 8090, 8091, 8092, 8093, 8094, 8095, 8096, \n        8097, 8098, 8099, 8100, 8101, 8102, 8103, 8104, 8105, 8106, 8107, 8108, 8109, 8110, \n        8111, 8112, 8113, 8114, 8115, 8116, 8117, 8118, 8119, 8120, 8200, 8222, 8223, 8224, \n        8225, 8226, 8227, 8228, 8229, 8230, 8231, 8232, 8233, 8234, 8235, 8236, 8237, 8238, \n        8239, 8240, 8241, 8242, 8243, 8244, 8245, 8246, 8247, 8248, 8249, 8250, 8251, 8252, \n        8253, 8254, 8255, 8256, 8257, 8258, 8259, 8260, 8261, 8262, 8263, 8264, 8265, 8266, \n        8267, 8268, 8269, 8270, 8271, 8272, 8273, 8274, 8275, 8276, 8277, 8278, 8279, 8280, \n        8281, 8282, 8283, 8284, 8285, 8286, 8287, 8288, 8289, 8290, 8291, 8292, 8293, 8294, \n        8295, 8296, 8297, 8298, 8299, 8300, 8301, 8302, 8303, 8304, 8305, 8306, 8307, 8308, \n        8309, 8310, 8311, 8312, 8313, 8314, 8315\n      ],\n      \"reason\": \"普段は視聴者側からは見えない3D配信中の舞台裏の工夫が面白く、トリビアとしてショート動画のアルゴリズムに乗りやすいテーマです。\",\n      \"compositionNote\": \"「トイレに行きたい時はカメラに指ハートをする」というルール説明から、ペコラが下手なペイントで指ハートを描くおちゃめなシーンを挟み、「実は大半の人が本番中トイレに行っていた」というオチに繋げます。\"\n    },\n    {\n      \"id\": \"theme_3\",\n      \"title\": \"まつり「ぺこちゃん、私のこと嫌いなの？」\",\n      \"summary\": \"楽屋から静かに逃げようとするコミュ障気味のペコラが、まつり先輩に「私のこと嫌いなの？」と捕まり、焦り倒す微笑ましいエピソード。\",\n      \"representativeSpeechIds\": [22396],\n      \"relatedSpeechIds\": [\n        22396, 22397, 22398, 22399, 22400, 22401, 22402, 22403, 22404, 22405, 22406, 22407, \n        22408, 22409, 22410, 22411, 22412, 22413, 22414, 22415, 22416, 22417, 22418, 22419, \n        22420, 22421, 22422, 22423, 22424, 22425, 22426, 22427, 22428, 22429, 22430, 22431, \n        22432, 22433, 22434, 22435, 22436, 22437, 22438, 22439, 22440, 22441, 22442, 22443, \n        22444, 22445, 22446, 22447, 22448, 22449, 22450, 22451, 22452, 22453, 22454, 22455, \n        22456, 22457, 22458, 22459, 22460, 22461, 22462, 22463, 22464, 22465, 22466, 22467, \n        22468, 22469, 22470, 22471, 22472, 22473, 22474, 22475, 22476, 22477, 22478, 22479, \n        22480, 22481, 22482, 22483, 22484, 22485, 22486, 22487, 22488, 22489, 22490, 22491, \n        22492, 22493, 22494, 22495, 22496, 22497, 22498, 22499, 22500, 22501, 22502, 22503, \n        22504, 22505, 22506, 22507, 22508, 22509, 22510, 22511, 22512, 22513, 22514, 22515, \n        22516, 22517, 22518, 22519, 22520, 22521, 22522, 22523, 22524, 22525, 22526, 22527, \n        22528, 22529, 22530, 22531, 22532, 22533, 22534, 22535, 22536, 22537, 22538, 22539, \n        22540, 22541, 22542, 22543, 22544, 22545, 22546, 22547, 22548, 22549, 22550, 22551, \n        22552, 22553, 22554, 22555, 22556, 22557, 22558, 22559, 22560, 22561, 22562, 22563, \n        22564, 22565, 22566, 22567, 22568, 22569, 22570, 22571, 22572, 22573, 22574, 22575, \n        22576, 22577, 22578, 22579, 22580, 22581, 22582, 22583, 22584, 22585, 22586, 22587, \n        22588, 22589, 22590, 22591, 22592, 22593\n      ],\n      \"reason\": \"「嫌いなの？」という強烈なインパクトワードから始まり、ペコラの「嫌いじゃない、ただの対人恐怖症！」という焦りと弁明のやり取りが爆笑を誘うコメディカルな仕上がりに適しています。\",\n      \"compositionNote\": \"冒頭に一番の山場である「嫌いなの？」と「嫌いじゃない！」のやり取りを持ってきて引き込み、その後、楽屋で世間話ができずにそそくさと逃げようとした哀しきコミュ障の背景をスピード感のあるカットで伝えます。\"\n    }\n  ]\n}",
